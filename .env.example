APP_NAME="Mahfuz Ahmed API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=maktech_laravel_api
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
# Prefer REDIS_URL for Coolify / managed Redis. Discrete vars are the fallback.
# Example: redis://default:password@127.0.0.1:6379/0
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_USERNAME=
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Browser origins allowed to use this API through the Next.js BFF.
# Comma-separated. FRONTEND_URL is the single-origin fallback.
# CORS and EnsureTrustedBff both read this list. The browser never calls
# this API directly; the BFF sends the page origin in X-Frontend-Origin.
FRONTEND_URLS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Shared secret the Next.js server sends as X-BFF-Secret. Required.
# Generate with: openssl rand -base64 32
# Must match BFF_SECRET on the Next.js app. Do not put the production
# value on Vercel preview deployments.
BFF_SECRET=

# Passport password grant client. Created once with:
#   php artisan passport:client --password
# Changing these signs every user out, so treat them as fixed secrets and never
# re-run passport:install or passport:client as part of a deploy.
PASSPORT_PASSWORD_CLIENT_ID=
PASSPORT_PASSWORD_CLIENT_SECRET=

# Passport token signing keys. Left blank, Passport falls back to
# storage/oauth-private.key, which lives inside the container and is therefore
# destroyed by every image rebuild - taking all issued tokens with it. Set both
# in production so keys outlive deploys. Generate once with `php artisan
# passport:keys` locally, then paste the file contents here, newlines included.
PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=

VITE_APP_NAME="${APP_NAME}"

# Scout. collection/null needs no search engine (Eloquent LIKE fallback).
# Production: typesense | meilisearch | algolia | turbopuffer, then
# `php artisan scout:import-all --fresh` (not on container boot).
SCOUT_DRIVER=collection
SCOUT_QUEUE=true
SCOUT_PREFIX=mahfuz_
SCOUT_HIT_LIMIT=1000

TYPESENSE_API_KEY=
TYPESENSE_HOST=typesense.next.maktechlaravel.cloud
TYPESENSE_PORT=443
TYPESENSE_PROTOCOL=https
TYPESENSE_PATH=

MEILISEARCH_HOST=https://mailisearch.next.maktechlaravel.cloud
MEILISEARCH_KEY=

ALGOLIA_APP_ID=
ALGOLIA_SECRET=
TURBOPUFFER_API_KEY=
TURBOPUFFER_REGION=gcp-us-central1
